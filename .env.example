DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional MySQL. If DB_NAME is empty, SQLite is used for easy local demo.
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional Ethereum / local Hardhat or Ganache RPC settings
WEB3_PROVIDER_URI=http://127.0.0.1:8545
VOTING_CONTRACT_ADDRESS=
WEB3_FROM_ADDRESS=
